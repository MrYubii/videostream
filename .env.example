# Copy to .env and adjust for your environment.
ENVIRONMENT=development

# SECURITY: use a long random value in production and store it in Azure App Service settings/Key Vault.
SECRET_KEY=change-me-in-production
TOKEN_EXPIRY_MINUTES=120

# Database. Local default is SQLite. Azure uses PostgreSQL Flexible Server.
DATABASE_URL=sqlite:///data/videostream.db

# Storage backend: local | azure | s3
STORAGE_BACKEND=local
MEDIA_ROOT=data/media
MAX_UPLOAD_MB=200

# Azure Blob Storage (required when STORAGE_BACKEND=azure)
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=videos

# AWS S3 (optional alternative backend)
S3_BUCKET=
S3_REGION=eu-west-1

# Scalability: response cache TTL (seconds) and rate limiting.
CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS (comma-separated). Restrict this to the deployed frontend origin in production.
CORS_ORIGINS=*
