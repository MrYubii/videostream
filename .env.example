# Copy to .env and adjust for your environment.
ENVIRONMENT=development

# SECURITY: change to a long random value in production.
SECRET_KEY=change-me-in-production
TOKEN_EXPIRY_MINUTES=120

# Database. Local default is SQLite. For cloud use a managed DB URL,
# e.g. postgresql+psycopg://user:pass@host/db or mssql+pyodbc://...
DATABASE_URL=sqlite:///data/videostream.db

# Storage backend: local | azure | s3
STORAGE_BACKEND=local
MEDIA_ROOT=data/media
MAX_UPLOAD_MB=200

# Azure Blob (used when STORAGE_BACKEND=azure)
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=videos

# AWS S3 (used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=eu-west-1

# Scalability: response cache TTL (seconds) and rate limiting.
CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS (comma-separated). "*" allows all origins.
CORS_ORIGINS=*
